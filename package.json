{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "name": "poool",
  "scripts": {
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "p:base": "yarn workspace @poool/eslint-config",
    "p:react": "yarn workspace @poool/eslint-config-react",
    "p:oxfmt": "yarn workspace @poool/oxfmt-config",
    "p:oxlint": "yarn workspace @poool/oxlint-config",
    "clean": "turbo run clean",
    "build": "turbo run build",
    "prepack": "yarn build && yarn lint && yarn tsc && yarn test",
    "preversion": "yarn prepack",
    "release": "lerna version",
    "release:publish": "lerna publish from-package --yes"
  },
  "devDependencies": {
    "@poool/eslint-config": "workspace:^",
    "@poool/eslint-config-react": "workspace:^",
    "@poool/oxfmt-config": "workspace:^",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/eslint": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-oxlint": "1.90.0",
    "execa": "10.2.1",
    "jest": "30.5.2",
    "lerna": "10.1.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2007",
    "ts-node": "10.9.2",
    "turbo": "2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "yarn@4.18.1"
}
